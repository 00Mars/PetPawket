  "roles": [
    {
      "role_key": "owner_root",
      "label": "Owner Root",
      "description": "Highest local authority for vault ownership, role grants, recovery, full archive, and period reopen approval."
    },
    {
      "role_key": "finance_admin",
      "label": "Finance Admin",
      "description": "Operational finance administrator for import review, ledger approval, documents, reports, corrections, and scoped exports."
    },
    {
      "role_key": "bookkeeper",
      "label": "Bookkeeper",
      "description": "Staging role for expenses, documents, reconciliations, and draft corrections."
    },
    {
      "role_key": "accountant_export_user",
      "label": "Accountant Export User",
      "description": "Limited export role for accountant and IRS support packs."
    },
    {
      "role_key": "foundation_admin",
      "label": "Foundation Admin",
      "description": "Mission reporting role for CHARM and future CHERISH records once approved."
    },
    {
      "role_key": "investor_read_only",
      "label": "Investor Read-Only",
      "description": "Restricted role for reviewed investor packages only."
    },
    {
      "role_key": "connector_node",
      "label": "Connector Node",
      "description": "Machine role for encrypted read-only source-event bundles."
