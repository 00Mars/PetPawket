{
  "name": "petpawket",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "description": "Pet Pawket — Node/Express + Shopify Storefront (Postgres-only)",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "db:test:setup": "node scripts/create-test-db.js --write-env",
    "seed:network": "node scripts/network-seed.js",
    "grant:network-ops": "node scripts/network-ops-grant.js",
    "start:charm": "node apps/charmfoundation/server.js",
    "dev:charm": "node --watch apps/charmfoundation/server.js",
    "migrate:charm": "node apps/charmfoundation/scripts/migrate.js",
    "dev:all": "node scripts/dev-all.js",
    "start:gateway": "node scripts/site-gateway.js",
    "dev:gateway": "node scripts/site-gateway.js",
    "test": "node --test tests/networkRoutes.test.js",
    "test:networkdb": "node --test tests/networkDB.integration.test.js",
    "test:networkdb:ci": "node scripts/network-test-ci.js",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "lint:css:fix": "stylelint \"**/*.css\" --fix --ignore-path .stylelintignore"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^3.1.3",
    "cheerio": "^1.1.2",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.6",
    "postcss-safe-parser": "^7.0.1",
    "puppeteer": "^24.25.0",
    "puppeteer-core": "^24.25.0",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4"
  }
}
